# ============================================
# UNIFIED ENVIRONMENT CONFIGURATION
# Works for both DEVELOPMENT and PRODUCTION
# Copy this file to .env and update the values
# ============================================

# ===========================================
# CHOOSE ONE: DATABASE CONFIGURATION
# ===========================================

# ✅ PRODUCTION - Remote Database Server
DATABASE_URL="postgresql://raport:raport_password_123@103.181.182.52:5432/raport_db"

# ❌ DEVELOPMENT - Local Database (uncomment to use)
# DATABASE_URL="postgresql://postgres:password@localhost:5432/raport_db"

# ===========================================
# CHOOSE ONE: APPLICATION ENVIRONMENT
# ===========================================

# ✅ PRODUCTION Mode
NODE_ENV="production"

# ❌ DEVELOPMENT Mode (uncomment to use)
# NODE_ENV="development"

# ===========================================
# APPLICATION URL
# ===========================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ===========================================
# JWT SECURITY KEYS
# Generate new keys: openssl rand -base64 32
# ===========================================
JWT_ACCESS_SECRET="change-this-to-secure-access-token-key-32-chars"
JWT_REFRESH_SECRET="change-this-to-secure-refresh-token-key-32-chars"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"
