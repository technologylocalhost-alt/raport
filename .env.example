# ============================================
# UNIFIED ENVIRONMENT CONFIGURATION
# Works for both DEVELOPMENT and PRODUCTION
# Copy this file to .env and update the values
# ============================================

# ===========================================
# CHOOSE ONE: DATABASE CONFIGURATION
# ===========================================

# ✅ OPTION 1: Supabase Managed PostgreSQL (Recommended)
# Get connection strings from: https://supabase.com/dashboard/project/_/settings/database
# Replace [YOUR-PASSWORD] with your actual Supabase database password

# Connection pooling (recommended for production - uses pgbouncer)
DATABASE_URL="postgresql://postgres.ylkadmkjyqlijhmsrsqc:[rd5Pztg5wwxRUZNP]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (only for migrations)
DIRECT_URL="postgresql://postgres.ylkadmkjyqlijhmsrsqc:[rd5Pztg5wwxRUZNP]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ❌ OPTION 2: Self-hosted Remote Database Server (Alternative)
# DATABASE_URL="postgresql://raport:raport_password_123@103.181.182.52:5432/raport_db"

# ❌ OPTION 3: Local Database for Development
# DATABASE_URL="postgresql://postgres:password@localhost:5432/raport_db"

# ===========================================
# CHOOSE ONE: APPLICATION ENVIRONMENT
# ===========================================

# ✅ PRODUCTION Mode
NODE_ENV="production"

# ❌ DEVELOPMENT Mode (uncomment to use)
# NODE_ENV="development"

# ===========================================
# APPLICATION URL
# ===========================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ===========================================
# JWT SECURITY KEYS
# Generate new keys: openssl rand -base64 32
# ===========================================
JWT_ACCESS_SECRET="change-this-to-secure-access-token-key-32-chars"
JWT_REFRESH_SECRET="change-this-to-secure-refresh-token-key-32-chars"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# ===========================================
# NEXTAUTH CONFIGURATION
# ===========================================
NEXTAUTH_SECRET="change-this-to-secure-nextauth-key-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# ===========================================
# OPTIONAL: Custom Port
# ===========================================
APP_PORT=3000
