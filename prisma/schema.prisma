generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String         @id @default(cuid())
  email              String         @unique
  name               String
  password           String
  role               UserRole
  schoolId           String
  isActive           Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  classesAsWaliKelas Class[]        @relation("ClassWaliKelas")
  classes            ClassTeacher[]
  grades             Grade[]
  nilaiApproves      NilaiApprove[] @relation("UserNilaiApprove")
  refreshTokens      RefreshToken[]
  competencies       Competency[]   @relation("TeacherCompetencies")
  activityLogs       ActivityLog[]
  school             School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([role])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model School {
  id          String       @id @default(cuid())
  name        String
  address     String?
  phone       String?
  email       String?
  npsn        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  levels      Level[]
  schoolYears SchoolYear[]
  users       User[]
}

model Level {
  id            String         @id @default(cuid())
  schoolId      String
  name          String
  code          String
  order         Int            @default(0)
  levelCount    Int            @default(0)
  description   String?        @default("")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  classes       Class[]
  gradeList     Grade[]
  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  nilaiApproves NilaiApprove[] @relation("LevelNilaiApprove")
  reportConfigs ReportConfig?
  subjects      Subject[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

model SchoolYear {
  id                    String     @id @default(cuid())
  schoolId              String
  year                  String
  tahunAkademik         String?
  tahunAkademikArabic   String?
  startDate             DateTime
  endDate               DateTime
  isActive              Boolean    @default(true)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  classes               Class[]
  school                School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  semesters             Semester[]

  @@unique([schoolId, year])
  @@index([schoolId])
}

model Semester {
  id                  String     @id @default(cuid())
  schoolYearId        String
  number              Int
  semesterLabel       String?
  semesterLabelArabic String?
  startDate           DateTime
  endDate             DateTime
  isActive            Boolean    @default(true)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  classes             Class[]
  schoolYear          SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)

  @@unique([schoolYearId, number])
  @@index([schoolYearId])
}

model Class {
  id           String         @id @default(cuid())
  levelId      String
  schoolYearId String
  semesterId   String
  name         String
  capacity     Int            @default(40)
  waliKelasId  String?
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  level        Level          @relation(fields: [levelId], references: [id], onDelete: Cascade)
  schoolYear   SchoolYear     @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  semester     Semester       @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  waliKelas    User?          @relation("ClassWaliKelas", fields: [waliKelasId], references: [id])
  subjects     ClassSubject[]
  teachers     ClassTeacher[]
  students     Student[]
  studentNotes StudentNote[]
  grades       Grade[]
  nilaiApproves NilaiApprove[]

  @@unique([levelId, schoolYearId, semesterId, name])
  @@index([levelId])
  @@index([schoolYearId])
  @@index([semesterId])
  @@index([waliKelasId])
}

model ClassTeacher {
  id        String   @id @default(cuid())
  classId   String
  teacherId String
  subjectId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher   User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([classId, teacherId, subjectId])
  @@index([classId])
  @@index([teacherId])
  @@index([subjectId])
}

model Student {
  id            String         @id @default(cuid())
  classId       String
  studentNo     String
  name          String
  nourut        Int?
  email         String?
  phone         String?
  gender        String         @default("MALE")
  birthDate     DateTime?
  address       String?
  parentPhoneNo String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  attendances   Attendance[]
  grades        Grade[]
  nilaiApproves NilaiApprove[] @relation("StudentNilaiApprove")
  class         Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  studentNotes  StudentNote[]

  @@unique([classId, studentNo])
  @@index([classId])
}

model Subject {
  id            String         @id @default(cuid())
  levelId       String?
  code          String
  name          String
  nameArabic    String?
  description   String?
  creditHours   Int?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  classSubjects ClassSubject[]
  teachers      ClassTeacher[]
  competencies  Competency[]
  nilaiApproves NilaiApprove[] @relation("SubjectNilaiApprove")
  grades        Grade[]        @relation("SubjectGrade")
  level         Level?         @relation(fields: [levelId], references: [id])

  @@index([levelId])
}

model ClassSubject {
  id        String   @id @default(cuid())
  classId   String
  subjectId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([classId, subjectId])
  @@index([classId])
  @@index([subjectId])
}

model Competency {
  id            String         @id @default(cuid())
  subjectId     String
  teacherId     String?
  code          String
  name          String
  description   String         @default("")
  type          CompetencyType
  order         Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subject       Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher       User?          @relation("TeacherCompetencies", fields: [teacherId], references: [id])
  grades        Grade[]
  nilaiApproves NilaiApprove[] @relation("CompetencyNilaiApprove")

  @@unique([subjectId, teacherId, code])
  @@index([subjectId])
  @@index([teacherId])
}

model Grade {
  id             String         @id @default(cuid())
  studentId      String
  classId        String
  competencyId   String?
  subjectId      String?
  levelId        String
  teacherId      String
  score          String
  scoringType    ScoringType
  assessmentType AssessmentType
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  class          Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  competency     Competency?    @relation(fields: [competencyId], references: [id], onDelete: SetNull)
  level          Level          @relation(fields: [levelId], references: [id], onDelete: Cascade)
  student        Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject        Subject?       @relation("SubjectGrade", fields: [subjectId], references: [id], onDelete: SetNull)
  teacher        User           @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([classId])
  @@index([competencyId])
  @@index([subjectId])
  @@index([levelId])
  @@index([teacherId])
}

model NilaiApprove {
  id             String         @id @default(cuid())
  studentId      String
  classId        String
  competencyId   String?
  subjectId      String
  levelId        String
  teacherId      String
  score          String
  scoringType    ScoringType
  assessmentType AssessmentType
  notes          String?
  nomorRaport    String?
  suluk          String?
  muazobah       String?
  nazofah        String?
  averageStudent Float?
  averageSubject Float?
  jumlahNilai    Float?
  mulahazoh      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  class          Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  competency     Competency?    @relation("CompetencyNilaiApprove", fields: [competencyId], references: [id], onDelete: SetNull)
  level          Level          @relation("LevelNilaiApprove", fields: [levelId], references: [id], onDelete: Cascade)
  student        Student        @relation("StudentNilaiApprove", fields: [studentId], references: [id], onDelete: Cascade)
  subject        Subject        @relation("SubjectNilaiApprove", fields: [subjectId], references: [id], onDelete: Cascade)
  teacher        User           @relation("UserNilaiApprove", fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([classId])
  @@index([competencyId])
  @@index([subjectId])
  @@index([levelId])
  @@index([teacherId])
}

model Attendance {
  id        String           @id @default(cuid())
  studentId String
  date      DateTime
  status    AttendanceStatus
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([studentId])
}

model StudentNote {
  id                   String   @id @default(cuid())
  studentId            String
  semesterId           String?
  classId              String
  developmentNotes     String?
  achievedCompetencies String?
  improvementAreas     String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  class                Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  student              Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId, semesterId])
  @@index([studentId])
  @@index([classId])
}

model Santri {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // === IDENTITAS PENDAFTARAN ===
  tahunDaftar       String?
  noPendaftaranPSB  String?
  studentNo         String   @unique // Nomor Stambuk
  tingkatSebelumnya String? // MI/SD, MTS/SMP, MA/SMA
  gender            String   @default("MALE") // MALE / FEMALE

  // === DATA DIRI SANTRI ===
  name          String
  namaPanggilan String?
  birthPlace    String?
  birthDate     DateTime?
  anakKe        Int?
  dariAnak      Int?
  nik           String?
  nisn          String?
  asalSekolah   String?
  nsmNpsn       String? // NSM/NPSN asal sekolah
  statusDomisili String? // Rumah Ortu, Nenek/Kakek, Saudara Ortu, Saudara Kandung, Lainnya
  alamatKK      String? // Alamat sesuai KK
  kodePos       String?
  domisiliLuar  String? // Domisili di luar alamat KK
  penanggungJawab     String? // Nama penanggung jawab
  penanggungJawabHP   String? // HP penanggung jawab
  ukuranPakaian String?
  bahasaSehariHari String?
  golonganDarah String?
  tinggiBadan   String?
  beratBadan    String?
  noBPJS        String?
  phone         String?
  address       String?
  parentPhoneNo String?

  // === KONDISI KESEHATAN ===
  kondisiGigi       String? // Normal, Tidak Rapi, Berlubang/Sakit-Kambuh
  kondisiFisik      String? // Normal, Cacat ___
  instansiKesehatanNama   String?
  instansiKesehatanAlamat String?
  instansiKesehatanHP     String?

  // === RIWAYAT PENYAKIT ===
  penyakitDalam     String? // Penyakit dalam (pernah/sedang)
  rawatJalan        String? // Rawat jalan & kambuh
  riwayatSakit      String? // Riwayat sakit (sudah sembuh)
  alergiMakanan     String?
  alergiObat        String?
  konsumsiObatRutin String?

  // === DATA ORANG TUA - AYAH ===
  ayahNama          String?
  ayahStatus        String? // Hidup / Wafat
  ayahTempatTglLahir String?
  ayahKebangsaan    String? // WNI / WNA
  ayahNIK           String?
  ayahNoKK          String?
  ayahAgama         String?
  ayahPendidikan    String? // SD/SMP/SMA/S1/S2/S3
  ayahPekerjaan     String?
  ayahPenghasilan   String?
  ayahAlamat        String?
  ayahTelepon       String?
  ayahEmail         String?

  // === DATA ORANG TUA - IBU ===
  ibuNama           String?
  ibuStatus         String? // Hidup / Wafat
  ibuTempatTglLahir String?
  ibuKebangsaan     String? // WNI / WNA
  ibuNIK            String?
  ibuNoKK           String?
  ibuAgama          String?
  ibuPendidikan     String?
  ibuPekerjaan      String?
  ibuPenghasilan    String?
  ibuAlamat         String?
  ibuTelepon        String?
  ibuEmail          String?

  // === PEMBIAYAAN ===
  sumberPembiayaan    String? // Orang tua, Hubungan Khusus, Beasiswa
  detailPembiayaan    String? // Detail siapa/lembaga
  nominalBantuan      String?
  periodeBantuan      String? // Harian/Mingguan/Bulanan/Semester/Tahunan

  // === DATA WALI ===
  waliStatus        String? // Status hubungan
  waliNama          String?
  waliTempatTglLahir String?
  waliNIK           String?
  waliNoKK          String?
  waliAgama         String?
  waliPendidikan    String?
  waliPekerjaan     String?
  waliPenghasilan   String?
  waliAlamat        String?
  waliKondisi       String? // Pembiayaan/Pengasuhan/dll

  // === RIWAYAT PENDIDIKAN ===
  pendidikanTK      String?
  pendidikanPAUD    String?
  pendidikanSD      String?
  pendidikanSMP     String?
  pendidikanSMA     String? // Pindahan / Lanjut

  // === RIWAYAT KELAS DI PPMDL ===
  riwayatKelas      String? // JSON: [{kelas, waliKelas, tahun}]

  // === RIWAYAT KAMAR DI PPMDL ===
  riwayatKamar      String? // JSON: [{kelas, tahun, semester1, semester2}]
  kamarBerkesan     String?

  // === MOTIVASI / ALASAN MASUK PONDOK ===
  motivasiMasuk         String?
  ikutOrangtuaAtauSendiri String?
  betahDiPondok         String?
  alasanBetah           String?
  alasanTidakBetah      String?
  janjiOrangtua         String?
  inspirasiDiPondok     String?
  sosokTeladan          String?
  sadarDewasa           String?
  dariManaTahuPPMDL     String?

  // === PROFIL LINGKUNGAN ===
  lingkunganSuku        String?
  lingkunganBahasa      String?
  lingkunganInteraksi   String?
  lingkunganTradisi     String?
  lingkunganGotongRoyong String?
  lingkunganPolitik     String?
  lingkunganOrmasMasyarakat String?
  lingkunganOrmasKeagamaan  String?
  lingkunganBeragama    String?
  lingkunganJarakMasjid String?
  lingkunganKeagamaan   String? // Pengajian, Yasinan, dll
  lingkunganJumlahMasjid String?
  lingkunganShalatJamaah String?
  lingkunganPendidikanMayoritas String?
  lingkunganLembagaPendidikan   String?
  lingkunganBudayaBelajar       String?
  lingkunganAksesInternet       String?
  lingkunganGadget              String?
  lingkunganMedsos              String?
  lingkunganOrganisasi          String?
  lingkunganKepemudaan          String?
  lingkunganKeamanan            String?
  lingkunganRonda               String?
  lingkunganPergaulanRemaja     String?

  // === PRESTASI & MINAT ===
  prestasi              String?
  kegiatanOrganisasi    String?
  kegiatanEkskul        String?
  subjekDigemari        String?

  // === KETERANGAN TAMBAHAN KESEHATAN ===
  pernahOperasi         String? // YA/TIDAK + detail
  penyakitKronis        String? // YA/TIDAK + detail
  alergiZat             String? // YA/TIDAK + detail
  gejalaSatuTahun       String? // YA/TIDAK + detail
  kebutuhanKhusus       String? // YA/TIDAK + detail

  // === LAIN-LAIN / PREFERENSI ===
  preferensiBahasa        String? // Arab / Inggris
  preferensiPelajaran     String? // Bahasa / Umum / Eksakta
  pelajaranArabDisukai    String?
  pelajaranInggrisDisukai String?
  pelajaranEksaktaDisukai String?
  pelajaranTidakDisukai   String?
  ekskulDisukai           String?
  ekskulTidakDisukai      String?
  kegiatanBesarDisukai    String?
  kegiatanBesarTidakDisukai String?
  rencanaMA               String?
  rencanaKuliah           String?
  rencanaKarier           String?
  tempatKerjaDiinginkan   String?
  profesiCitaCita         String?
  skillDipelajari         String?
  target10Tahun           String? // JSON: [{tahun, target}]

  // === ADMINISTRASI ===
  diInputOleh     String?
  tanggalInput    DateTime?
  catatanSekpim   String?

  @@index([studentNo])
  @@index([name])
}

model ReportConfig {
  id               String      @id @default(cuid())
  levelId          String      @unique
  scoringType      ScoringType
  minScore         String
  maxScore         String
  includeAttitude  Boolean     @default(true)
  includeSkills    Boolean     @default(true)
  includeKnowledge Boolean     @default(true)
  weightAttitude   Int         @default(10)
  weightSkills     Int         @default(45)
  weightKnowledge  Int         @default(45)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  level            Level       @relation(fields: [levelId], references: [id], onDelete: Cascade)
}

enum UserRole {
  ADMIN
  TEACHER
  PRINCIPAL
  WALI_KELAS
}

enum CompetencyType {
  KNOWLEDGE
  SKILL
  ATTITUDE
}

enum ScoringType {
  NUMERIC_1_4
  NUMERIC_0_100
  LETTER_A_D
  LETTER_E_A
}

enum AssessmentType {
  UTS_1       // Ujian Tengah Semester 1
  UAS_1       // Ujian Akhir Semester 1
  UTS_2       // Ujian Tengah Semester 2
  UAS_2       // Ujian Akhir Semester 2
  FINAL_EXAM_1  // Ujian Akhir Siswa Akhir Gel 1
  FINAL_EXAM_2  // ujian Akhir Siswa Akhir Gel 2
}

enum AttendanceStatus {
  HADIR
  SAKIT
  IZIN
  ALFA
}

enum ActivityAction {
  CREATE
  READ
  UPDATE
  DELETE
  APPROVE
  REJECT
  LOGIN
  LOGOUT
  IMPORT
  EXPORT
  BULK_UPDATE
  RESTORE
}

enum ActivityStatus {
  SUCCESS
  FAILED
  PARTIAL
}

model ActivityLog {
  id              String         @id @default(cuid())
  userId          String
  action          ActivityAction
  resourceType    String
  resourceId      String?
  resourceName    String?
  description     String?
  oldValue        String?
  newValue        String?
  ipAddress       String?
  userAgent       String?
  status          ActivityStatus @default(SUCCESS)
  errorMessage    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([action])
  @@index([resourceType])
  @@index([resourceId])
}
