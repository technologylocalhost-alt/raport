generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String         @id @default(cuid())
  email              String         @unique
  name               String
  password           String
  role               UserRole
  schoolId           String
  isActive           Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  classesAsWaliKelas Class[]        @relation("ClassWaliKelas")
  classes            ClassTeacher[]
  grades             Grade[]
  nilaiApproves      NilaiApprove[] @relation("UserNilaiApprove")
  refreshTokens      RefreshToken[]
  competencies       Competency[]   @relation("TeacherCompetencies")
  school             School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([role])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model School {
  id          String       @id @default(cuid())
  name        String
  address     String?
  phone       String?
  email       String?
  npsn        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  levels      Level[]
  schoolYears SchoolYear[]
  users       User[]
}

model Level {
  id            String         @id @default(cuid())
  schoolId      String
  name          String
  code          String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  classes       Class[]
  gradeList     Grade[]
  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  nilaiApproves NilaiApprove[] @relation("LevelNilaiApprove")
  reportConfigs ReportConfig?
  subjects      Subject[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

model SchoolYear {
  id        String     @id @default(cuid())
  schoolId  String
  year      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  classes   Class[]
  school    School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  semesters Semester[]

  @@unique([schoolId, year])
  @@index([schoolId])
}

model Semester {
  id           String     @id @default(cuid())
  schoolYearId String
  number       Int
  startDate    DateTime
  endDate      DateTime
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  classes      Class[]
  schoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)

  @@unique([schoolYearId, number])
  @@index([schoolYearId])
}

model Class {
  id           String         @id @default(cuid())
  levelId      String
  schoolYearId String
  semesterId   String
  name         String
  capacity     Int            @default(40)
  waliKelasId  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  level        Level          @relation(fields: [levelId], references: [id], onDelete: Cascade)
  schoolYear   SchoolYear     @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  semester     Semester       @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  waliKelas    User?          @relation("ClassWaliKelas", fields: [waliKelasId], references: [id])
  subjects     ClassSubject[]
  teachers     ClassTeacher[]
  students     Student[]
  studentNotes StudentNote[]

  @@unique([levelId, schoolYearId, semesterId, name])
  @@index([levelId])
  @@index([schoolYearId])
  @@index([semesterId])
  @@index([waliKelasId])
}

model ClassTeacher {
  id        String   @id @default(cuid())
  classId   String
  teacherId String
  subjectId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher   User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([classId, teacherId, subjectId])
  @@index([classId])
  @@index([teacherId])
  @@index([subjectId])
}

model Student {
  id            String         @id @default(cuid())
  classId       String
  studentNo     String
  name          String
  nourut        Int?
  email         String?
  phone         String?
  gender        String         @default("MALE")
  birthDate     DateTime?
  address       String?
  parentPhoneNo String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  attendances   Attendance[]
  grades        Grade[]
  nilaiApproves NilaiApprove[] @relation("StudentNilaiApprove")
  class         Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  studentNotes  StudentNote[]

  @@unique([classId, studentNo])
  @@index([classId])
}

model Subject {
  id            String         @id @default(cuid())
  levelId       String?
  code          String
  name          String
  nameArabic    String?
  description   String?
  creditHours   Int?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  classSubjects ClassSubject[]
  teachers      ClassTeacher[]
  competencies  Competency[]
  nilaiApproves NilaiApprove[] @relation("SubjectNilaiApprove")
  level         Level?         @relation(fields: [levelId], references: [id])

  @@index([levelId])
}

model ClassSubject {
  id        String   @id @default(cuid())
  classId   String
  subjectId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([classId, subjectId])
  @@index([classId])
  @@index([subjectId])
}

model Competency {
  id            String         @id @default(cuid())
  subjectId     String
  teacherId     String?
  code          String
  name          String
  description   String         @default("")
  type          CompetencyType
  order         Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subject       Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher       User?          @relation("TeacherCompetencies", fields: [teacherId], references: [id])
  grades        Grade[]
  nilaiApproves NilaiApprove[] @relation("CompetencyNilaiApprove")

  @@unique([subjectId, teacherId, code])
  @@index([subjectId])
  @@index([teacherId])
}

model Grade {
  id             String         @id @default(cuid())
  studentId      String
  competencyId   String
  levelId        String
  teacherId      String
  score          String
  scoringType    ScoringType
  assessmentType AssessmentType
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  competency     Competency     @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  level          Level          @relation(fields: [levelId], references: [id], onDelete: Cascade)
  student        Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher        User           @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([studentId, competencyId, teacherId, assessmentType])
  @@index([studentId])
  @@index([competencyId])
  @@index([levelId])
  @@index([teacherId])
}

model NilaiApprove {
  id             String         @id @default(cuid())
  studentId      String
  competencyId   String
  subjectId      String
  levelId        String
  teacherId      String
  score          String
  scoringType    ScoringType
  assessmentType AssessmentType
  notes          String?
  nomorRaport    String?
  suluk          String?
  muazobah       String?
  nazofah        String?
  averageStudent Float?
  averageSubject Float?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  competency     Competency     @relation("CompetencyNilaiApprove", fields: [competencyId], references: [id], onDelete: Cascade)
  level          Level          @relation("LevelNilaiApprove", fields: [levelId], references: [id], onDelete: Cascade)
  student        Student        @relation("StudentNilaiApprove", fields: [studentId], references: [id], onDelete: Cascade)
  subject        Subject        @relation("SubjectNilaiApprove", fields: [subjectId], references: [id], onDelete: Cascade)
  teacher        User           @relation("UserNilaiApprove", fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([studentId, competencyId, teacherId, assessmentType])
  @@index([studentId])
  @@index([competencyId])
  @@index([subjectId])
  @@index([levelId])
  @@index([teacherId])
}

model Attendance {
  id        String           @id @default(cuid())
  studentId String
  date      DateTime
  status    AttendanceStatus
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([studentId])
}

model StudentNote {
  id                   String   @id @default(cuid())
  studentId            String
  semesterId           String?
  classId              String
  developmentNotes     String?
  achievedCompetencies String?
  improvementAreas     String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  class                Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  student              Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId, semesterId])
  @@index([studentId])
  @@index([classId])
}

model ReportConfig {
  id               String      @id @default(cuid())
  levelId          String      @unique
  scoringType      ScoringType
  minScore         String
  maxScore         String
  includeAttitude  Boolean     @default(true)
  includeSkills    Boolean     @default(true)
  includeKnowledge Boolean     @default(true)
  weightAttitude   Int         @default(10)
  weightSkills     Int         @default(45)
  weightKnowledge  Int         @default(45)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  level            Level       @relation(fields: [levelId], references: [id], onDelete: Cascade)
}

enum UserRole {
  ADMIN
  TEACHER
  PRINCIPAL
  WALI_KELAS
}

enum CompetencyType {
  KNOWLEDGE
  SKILL
  ATTITUDE
}

enum ScoringType {
  NUMERIC_1_4
  NUMERIC_0_100
  LETTER_A_D
  LETTER_E_A
}

enum AssessmentType {
  UTS_1       // Ujian Tengah Semester 1
  UAS_1       // Ujian Akhir Semester 1
  UTS_2       // Ujian Tengah Semester 2
  UAS_2       // Ujian Akhir Semester 2
  FINAL_EXAM_1  // Ujian Akhir Siswa Akhir Gel 1
  FINAL_EXAM_2  // ujian Akhir Siswa Akhir Gel 2
}

enum AttendanceStatus {
  HADIR
  SAKIT
  IZIN
  ALFA
}
